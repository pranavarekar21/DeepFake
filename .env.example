# Copy to .env and edit. All values are optional.

# Hugging Face token (only needed for gated / private models)
HF_TOKEN=

# Default Tier-1 image classifier (pretrained). Replace with your own.
IMAGE_MODEL_ID=prithivMLmods/deepfake-detector-model-v1

# Recommended primary foundation encoder (DINOv2 / DINOv3) + linear probe.
# Set to the encoder you extracted features with (hub id or local dir).
# Requires artifacts/probe.npz for the probe backend to activate.
EMBED_MODEL_ID=facebook/dinov2-base

# Complementary semantic branch (SigLIP / CLIP-style).
SIGLIP_MODEL_ID=google/siglip-base-patch16-224

# Frequency expert preference (empty = use trained spectral head only).
FREQUENCY_MODEL_ID=

# Audio deepfake detector (AASIST-style or XLS-R + head).
AUDIO_MODEL_ID=mo-thecreator/Deepfake-audio-detection

# Optional speech foundation encoder features.
WAVLM_MODEL_ID=microsoft/wavlm-large

# Video temporal preference: empty | ftcn | videomae | timesformer | HF id
VIDEO_TEMPORAL_MODEL_ID=

# auto | cpu | cuda | mps
DEEPFAKE_DEVICE=auto

# Conformal risk level: the true label is inside the predicted set at least
# 1 - alpha of the time (0.1 = 90%).
DEEPFAKE_ALPHA=0.1

# Where calibration, probes and signing keys are stored.
DEEPFAKE_ARTIFACT_DIR=artifacts

# Test-time-augmentation views for the image Tier-1 screen (1 = off, 3 = original+mirror+crop).
DEEPFAKE_TTA_VIEWS=3

# --- Recommended architecture / novel features (defaults favour the advanced stack) ---
DEEPFAKE_CONTROLLER=1
DEEPFAKE_CONTROLLER_POLICY=voi   # voi | fixed | random | quality
DEEPFAKE_RISK_TARGET=0.05
DEEPFAKE_BUDGET=1.5
DEEPFAKE_DEP_FUSION=1
DEEPFAKE_CONDITIONAL=0
DEEPFAKE_ROBUSTNESS_GATE=1
DEEPFAKE_LOCALIZATION=1
DEEPFAKE_PROVENANCE=1
DEEPFAKE_MIN_SUFFICIENCY=0
DEEPFAKE_INDEPENDENT=0
DEEPFAKE_FACE_SECONDS=8

# --- Media ingestion security (P1) ---
DEEPFAKE_MAX_UPLOAD_BYTES=104857600
DEEPFAKE_MAX_IMAGE_PIXELS=25000000
DEEPFAKE_MAX_VIDEO_SECONDS=120
DEEPFAKE_MAX_AUDIO_SECONDS=300
DEEPFAKE_MAX_ANALYSIS_SECONDS=180
DEEPFAKE_MAX_VIDEO_FRAMES=64
